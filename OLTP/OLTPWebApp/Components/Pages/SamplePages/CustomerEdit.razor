@page "/SamplePages/CustomerEdit/{CustomerID:int}"
<!--
	A route parameter goes inside { }: {ParameterName:Datatype}
	The name must exactly match the [Parameter] property in the code behind.
-->

<MudText Typo="Typo.h3">
	@(CustomerID > 0 
		? $"Customer Edit: {editCustomer.FirstName} {editCustomer.LastName}" 
		: "New Customer")
</MudText>

<DMIT2018FeedbackAndErrorDisplay ErrorDetails="@errorDetails" ErrorMessage="@errorMessage" FeedbackMessage="@feedbackMessage" />

<MudForm @ref="customerForm" @bind-IsValid="isFormValid" @bind-IsTouched="hasFormChanged">
	<MudGrid>
		<!--Column One-->
		<MudItem xs="12" sm="6">
			<MudTextField Label="First Name"
						  @bind-Value="editCustomer.FirstName"
						  Variant="Variant.Outlined" 
						  Immediate
						  Required
						  RequiredError="First Name must be provided."
						  MaxLength="20" />
			<MudTextField Label="Last Name"
						  @bind-Value="editCustomer.LastName"
						  Variant="Variant.Outlined"
						  Immediate
						  Required
						  RequiredError="Last Name must be provided."
						  MaxLength="50" />
			<MudTextField Label="Address 1"
						  @bind-Value="editCustomer.Address1"
						  Variant="Variant.Outlined"
						  Immediate
						  Required
						  RequiredError="Address 1 must be provided."
						  MaxLength="50" />
			<MudTextField Label="Address 2"
						  @bind-Value="editCustomer.Address2"
						  Variant="Variant.Outlined"
						  Immediate
						  MaxLength="50" />
			<MudTextField Label="City"
						  @bind-Value="editCustomer.City"
						  Variant="Variant.Outlined"
						  Immediate
						  Required
						  RequiredError="City must be provided."
						  MaxLength="50" />
			<MudSelect @bind-Value="editCustomer.ProvStateID"
					   Variant="Variant.Outlined"
					   Label="Province"
					   Required
					   RequiredError="Province must be selected."
					   Placeholder="Select Province..."
					   Clearable>
				@foreach(var item in provinces)
				{
					<MudSelectItem T="int?" Value="@item.LookupID">@item.Name</MudSelectItem>
				}
			</MudSelect>
		</MudItem>
		<!--Column Two-->
		<MudItem xs="12" sm="6">
			<MudSelect @bind-Value="editCustomer.CountryID"
					   Variant="Variant.Outlined"
					   Label="Country"
					   Required
					   RequiredError="Country must be selected."
					   Placeholder="Select Country..."
					   Clearable>
				@foreach (var item in countries)
				{
					<MudSelectItem T="int?" Value="@item.LookupID">@item.Name</MudSelectItem>
				}
			</MudSelect>
			<!--
                Postal Code: a Mask controls what can be typed.
                    "a0a 0a0": a = letter, 0 = digit, the space is added for the user.
                    Transformation runs on every character: here it makes letters uppercase.
                A mask doesn't stop a half-typed value (T5G 2), so Validation checks the
                finished value against a regular expression (see ValidatePostalCode).
            -->
			<MudTextField Label="Postal Code"
						  @bind-Value="editCustomer.PostalCode"
						  Variant="Variant.Outlined"
						  Mask="postalCodeMask"
						  Placeholder="T5W 5T5"
						  Immediate
						  Required
						  RequiredError="Postal Code must be provided."
						  Validation="@(new Func<string, string?>(ValidatePostalCode))"
						  MaxLength="20" />
			<!--
                Phone: the user sees (780) 555-1234, but CleanDelimiters removes the
                    ( ) - and space, so the value saved is just the digits: 7805551234.
                    Saved numbers come back from the database as digits and the mask
                    formats them again for display.
            -->
			<MudTextField Label="Phone Number"
						  @bind-Value="editCustomer.Phone"
						  Variant="Variant.Outlined"
						  Mask="phoneMask"
						  Placeholder="(780) 555-1234"
						  Immediate
						  Required
						  RequiredError="Phone Number must be provided."
						  Validation="@(new Func<string, string?>(ValidatePhone))"
						  MaxLength="20" />
			<!--
                Email: there's no fixed pattern for an email, so no mask.
                    InputType.Email gives phones the email keyboard.
                    .NET's built-in EmailAddressAttribute only checks for an "at" sign in the middle,
                    so it accepts an address with no dot after it. ValidateEmail uses a regular expression instead,
                    which also needs a domain ending like .com or .ca.
                    The email is trimmed and lowercased in SaveCustomer before it is saved.
            -->
			<MudTextField Label="Email"
						  @bind-Value="editCustomer.Email"
						  Variant="Variant.Outlined"
						  InputType="InputType.Email"
						  Placeholder="name@example.ca"
						  Immediate
						  Required
						  RequiredError="Email must be provided."
						  Validation="@(new Func<string, string?>(ValidateEmail))"
						  MaxLength="250" />
			<MudSelect @bind-Value="editCustomer.StatusID"
					   Variant="Variant.Outlined"
					   Label="Status"
					   Required
					   RequiredError="Status must be selected."
					   Placeholder="Select Status..."
					   Clearable>
				@foreach (var item in statuses)
				{
					<MudSelectItem T="int?" Value="@item.LookupID">@item.Name</MudSelectItem>
				}
			</MudSelect>
		</MudItem>
		<MudItem xs="12">
			<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4">
				<MudButton Variant="Variant.Filled"
						   Color="Color.Primary"
						   Disabled="@(!isFormValid || !hasFormChanged)"
						   OnClick="SaveCustomer">
					Save	   
				</MudButton>
				<MudButton Variant="Variant.Filled"
						   Color="Color.Secondary"
						   OnClick="CancelAsync">
					@closeButtonText
				</MudButton>
				<MudButton Variant="Variant.Filled"
						   Color="Color.Error"
						   Disabled="@(editCustomer.CustomerID == 0)"
						   OnClick="DeleteCustomer">
					Delete	  
				</MudButton>
			</MudStack>
		</MudItem>
		<!-- The customer invoices with only show once a customer is saved -->
		@if(editCustomer.CustomerID != 0)
		{
			<MudItem xs="12" Class="mt-4">
				<MudDataGrid Items="editCustomer.Invoices"
							 Striped
							 FixedFooter
							 FixedHeader
							 Height="20vh">
					<ToolBarContent>
						<MudText Typo="Typo.h6">Invoices</MudText>
						<MudSpacer />
						<MudButton Variant="Variant.Filled"
								   Color="Color.Success"
								   OnClick="NewInvoice">
							Add Invoice	   
						</MudButton>
					</ToolBarContent>
					<Columns>
						<TemplateColumn>
							<HeaderTemplate>
								Actions
							</HeaderTemplate>
							<CellTemplate>
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Secondary"
										   OnClick="() => EditInvoice(context.Item.InvoiceID)">
									Edit Invoice
								</MudButton>
							</CellTemplate>
						</TemplateColumn>
						<PropertyColumn Property="x => x.InvoiceID" Title="Invoice ID" />
						<PropertyColumn Property="x => x.InvoiceDate" Title="Date" />
						<PropertyColumn Property="x => x.EmployeeName" Title="Employee" />
						<PropertyColumn Property="@(x => x.Total.ToString("C2"))" Title="Total" />
					</Columns>
					<NoRecordsContent>
						<MudText Typo="Typo.h6">No invoices for this customer.</MudText>
					</NoRecordsContent>
					<PagerContent>
						<MudDataGridPager />
					</PagerContent>
				</MudDataGrid>
			</MudItem>
		}
		
	</MudGrid>
</MudForm>